# Copy this file to .env for local development and fill in real values.
# In production (Render), set these as Environment Variables in the dashboard instead —
# never commit a real .env file to git.

SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Used only to bootstrap the very first admin account if admin_users is empty.
# After that first login, manage admins from the Admin Panel's "Admins" tab.
ADMIN_BOOTSTRAP_USERNAME="admin"
ADMIN_BOOTSTRAP_PASSCODE="change-me"

***REMOVED***
